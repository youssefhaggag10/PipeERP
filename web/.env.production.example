DOMAIN=erp.example.com
POSTGRES_DB=pipeerp
POSTGRES_USER=pipeerp_app
ALLOWED_ORIGINS=https://erp.example.com
ACCESS_TOKEN_MINUTES=15
REFRESH_SESSION_HOURS=12
LOGIN_LOCK_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
BACKUP_RETENTION_DAYS=14

# ضع الملفات الفعلية خارج Git وبصلاحية 0600، ثم عدّل المسارات عند الحاجة.
POSTGRES_PASSWORD_FILE_PATH=./secrets/postgres_password
DATABASE_URL_FILE_PATH=./secrets/database_url
SECRET_KEY_FILE_PATH=./secrets/secret_key
BACKUP_ENCRYPTION_KEY_FILE_PATH=./secrets/backup_encryption_key
